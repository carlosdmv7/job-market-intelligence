# Copy to .env and fill in. Loaded by jmi_core.settings (pydantic-settings).
# .env is gitignored — nothing here is ever committed.
#
# The default stack is 0€: MotherDuck free tier + Gemini free tier + free
# public job APIs. Only the MotherDuck token is strictly required; without a
# Gemini key everything still runs except the LLM steps.

# === REQUIRED ==============================================================
# MotherDuck token (https://app.motherduck.com -> Settings -> Access Tokens).
# A read-only token is enough for the app; the pipeline needs read/write.
motherduck_token=

# Which MotherDuck database to use (must already exist in the MotherDuck UI).
JMI_DUCKDB_DATABASE=md:job-market-intelligence
# For fully-local dev with no cloud at all, use a file instead:
# JMI_DUCKDB_DATABASE=data/job_market.duckdb

# === LLM (default: Gemini free tier) =======================================
# Key from https://aistudio.google.com/apikey — free, no card.
GEMINI_API_KEY=
JMI_LLM_PROVIDER=gemini
JMI_LLM_MODEL=gemini-2.5-flash-lite

# The free tier's daily cap is counted in REQUESTS, not tokens (a measured 20
# per day per model), so how many postings ride in one request is the entire
# multiplier on daily coverage: 10 postings/request = 200 postings/day.
JMI_ENRICHMENT_POSTINGS_PER_REQUEST=10
# How many postings one `make enrich` run pulls from the queue.
JMI_ENRICHMENT_BATCH_SIZE=50
JMI_ENRICHMENT_PROMPT_VERSION=enrich/v2
# Seconds between calls — stays under the free tier's per-minute cap instead of
# spending the daily budget on retries.
JMI_GEMINI_MIN_INTERVAL_S=7

# --- Alternative providers (optional) --------------------------------------
# Fully local, no key, no quota — needs ~6-8 GB RAM for a 7B model, so it is a
# laptop option, not a deployment one (see ADR 0008).
#   Install https://ollama.com then: `ollama pull qwen2.5:7b`
# JMI_LLM_PROVIDER=ollama
# JMI_LLM_MODEL=qwen2.5:7b
# JMI_OLLAMA_HOST=http://localhost:11434
# JMI_OLLAMA_NUM_THREAD=6      # 0 = every core; lower = cooler and quieter
# JMI_OLLAMA_KEEP_ALIVE=5m     # 0 unloads now, 5m keeps it warm, -1 never
#
# Anthropic (paid, real cost tracking):
# JMI_LLM_PROVIDER=anthropic
# JMI_LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=

# === Scraping ==============================================================
JMI_SCRAPE_MAX_POSTINGS=200

# Adzuna — the per-country local corpora (NL/DE/ES). Free key, no card:
# https://developer.adzuna.com. Without it you still get the remote-first
# boards and Sweden, but not the local markets.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Scrapfly (LinkedIn/Indeed via anti-bot proxy) — registered, not on the 0€ path:
# SCRAPFLY_KEY=

# === Logging ===============================================================
JMI_LOG_LEVEL=INFO
JMI_LOG_JSON=false
